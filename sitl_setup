#!/usr/bin/env python3
"""Launch ArduPilot SITL using the sibling ArduPilot checkout."""

from __future__ import annotations

import argparse
import os
from pathlib import Path
import shlex
import shutil
import sys
import tempfile


def ardupilot_path(script_dir: Path) -> Path:
    """Prefer the environment, then .env, then the sibling checkout."""
    value = os.environ.get("ARDUPILOT_PATH", "")
    env_file = script_dir / ".env"
    if not value and env_file.is_file():
        for line in env_file.read_text().splitlines():
            key, separator, setting = line.partition("=")
            if separator and key.strip() == "ARDUPILOT_PATH":
                # Accept the shell-quoted paths written by the installer.
                # Parse the value as data without executing shell commands.
                tokens = shlex.split(setting, comments=True)
                if len(tokens) > 1:
                    raise ValueError("Quote paths containing spaces in .env.")
                value = tokens[0] if tokens else ""

    path = Path(value or "../ardupilot").expanduser()
    if not path.is_absolute():
        path = script_dir / path
    return path.resolve()


def main(
    vehicle_args: tuple[str, ...] = ("-v", "ArduCopter"),
    description: str = "Launch ArduCopter SITL.",
) -> int:
    parser = argparse.ArgumentParser(description=description)
    parser.add_argument("latitude", type=float, help="Latitude in degrees (-90 to 90).")
    parser.add_argument("longitude", type=float, help="Longitude in degrees (-180 to 180).")
    parser.add_argument("--headless", action="store_true", help="Disable windows and the MAVProxy prompt.")
    args = parser.parse_args()
    if not (-90 <= args.latitude <= 90 and -180 <= args.longitude <= 180):
        parser.error("latitude must be between -90 and 90, longitude between -180 and 180")

    script_dir = Path(__file__).resolve().parent
    try:
        checkout = ardupilot_path(script_dir)
        sim_vehicle = checkout / "Tools/autotest/sim_vehicle.py"
        if not sim_vehicle.is_file():
            raise ValueError(
                f"ArduPilot not found at {checkout}. "
                "Initialize ../ardupilot or set ARDUPILOT_PATH."
            )
        if shutil.which("mavproxy.py") is None:
            raise ValueError(
                "mavproxy.py is missing from PATH. Install ArduPilot prerequisites "
                "and activate its Python environment (see README.md)."
            )
        bash = shutil.which("bash")
        if bash is None:
            raise ValueError("Bash is required by ArduPilot's SITL launcher.")

        environment = os.environ.copy()
        environment["SIMCORE_CHECKOUT"] = str(script_dir)
        mavproxy_args = "--streamrate=-1"
        mode_args = ["--map", "--console"]
        if args.headless:
            mode_args = []
            mavproxy_args += " --daemon"
            # Prevent SITL from opening a terminal window or multiplexer.
            for name in ("DISPLAY", "TMUX", "STY", "ZELLIJ", "SITL_RITW_TERMINAL"):
                environment.pop(name, None)

        # Launch SITL as a child shell instead of through a terminal server,
        # which can discard our process tag. Map/console windows still work.
        environment["SITL_RITW_TERMINAL"] = bash

        run_dir = tempfile.mkdtemp(prefix="simcore-")
        print(f"Simulation state and logs: {run_dir}", flush=True)
        command = [
            sys.executable,
            str(sim_vehicle),
            *vehicle_args,
            "-w",
            "-l", f"{args.latitude},{args.longitude},0,0",
            "--use-dir", run_dir,
            "--no-extra-ports",
            "--out=127.0.0.1:14550",
            "--out=127.0.0.1:14551",
            f"--mavproxy-args={mavproxy_args}",
            *mode_args,
        ]
        # Replace the launcher so ArduPilot owns the process and Ctrl-C cleanup.
        os.chdir(script_dir)
        os.execve(sys.executable, command, environment)
    except (OSError, ValueError) as exc:
        print(f"Setup failed: {exc}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
